//@version=4
study(title="Suraj Bot", overlay = true)
//CREDITS to HPotter for the orginal code. The guy trying to sell this as his own is a scammer lol.
src = close

keyvalue = input(2, title = "Key Vaule. 'This changes the sensitivity'", step = .5)
atrperiod = input(2, title="ATR Period")
webhook_secret = input("", title="Webhook Secret")
xATR = atr(atrperiod)
nLoss = keyvalue * xATR

xATRTrailingStop = 0.0
xATRTrailingStop := iff(src > nz(xATRTrailingStop[1], 0) and src[1] > nz(xATRTrailingStop[1], 0), max(nz(xATRTrailingStop[1]), src - nLoss),
   iff(src < nz(xATRTrailingStop[1], 0) and src[1] < nz(xATRTrailingStop[1], 0), min(nz(xATRTrailingStop[1]), src + nLoss),
   iff(src > nz(xATRTrailingStop[1], 0), src - nLoss, src + nLoss)))

pos = 0
pos :=	iff(src[1] < nz(xATRTrailingStop[1], 0) and src > nz(xATRTrailingStop[1], 0), 1,
   iff(src[1] > nz(xATRTrailingStop[1], 0) and src < nz(xATRTrailingStop[1], 0), -1, nz(pos[1], 0)))

xcolor = pos == -1 ? color.red: pos == 1 ? color.green : color.blue

plot(xATRTrailingStop, color = xcolor, title = "Trailing Stop")
buy = crossover(src,xATRTrailingStop)
sell = crossunder(src,xATRTrailingStop)
barcolor = src > xATRTrailingStop

plotshape(buy, title = "Buy", text = 'Buy', style = shape.labelup, location = location.belowbar, color= color.green,textcolor = color.white, transp = 0, size = size.tiny)
plotshape(sell, title = "Sell", text = 'Sell', style = shape.labeldown, color= color.red,textcolor = color.white, transp = 0, size = size.tiny)

barcolor(barcolor? color.green:color.red)

alertcondition(buy, title='BOT Buy', message='BOT Buy')
alertcondition(sell, title='BOT Sell', message='BOT Sell')

// --- webhook heartbeat: fires once per closed bar with the current trail
// state, mirroring atr_bridge.ATRSnapshot (trail_stop/trend/event_time) so
// the Python side reads it the same way as the MT5 ATR trail bridge does.
var float event_time_ms = na
if buy or sell
    event_time_ms := time

event_time_sec = na(event_time_ms) ? 0 : round(event_time_ms / 1000)
bar_time_sec = round(time / 1000)

atr_payload = '{"secret":"' + webhook_secret + '","type":"atr_trail","symbol":"' + syminfo.ticker +
  '","timeframe":"' + timeframe.period + '","trail_stop":' + tostring(xATRTrailingStop) +
  ',"trend":' + tostring(pos, '#') + ',"event_time":' + tostring(event_time_sec, '#') +
  ',"bar_time":' + tostring(bar_time_sec, '#') + '}'

alert(atr_payload, alert.freq_once_per_bar_close)

// trend exposed via Data Window for tv_scraper to poll directly (Trailing
// Stop is already visible by default). No `display` param in Pine v4 --
// transparent plot instead; -1/0/1 range is negligible against price scale.
// event_time skipped: its raw unix
// value would wreck price auto-scale if plotted on this overlay chart.
plot(pos, "Trend", color = color.new(color.white, 100))
