// OBD_Reversal v1.02 -- order block detection + retest/mitigation webhooks
// feeding v3's Reversal Manager (see v3/signal_engine/reversal_manager.py).
// Base order-block detection/mitigation logic originally from LuxAlgo's
// "Order Block Detector" (CC BY-NC-SA 4.0), substantially modified since:
// retest tracking (mark_retests), the ob_zone_formed/mitigated/retested
// webhook payloads, and the remove_mitigated index-safety fixes are all
// new. Original license terms: https://creativecommons.org/licenses/by-nc-sa/4.0/
//
// HEADLESS by design (v1.02, 2026-08-20) -- draws NOTHING on the chart
// (no boxes, no lines, no dots, no Data Window plots). This script's only
// job is computing zones internally and firing alert() webhooks; nothing
// downstream (tv_bridge.receiver) reads anything visual, only the JSON
// payloads. It's meant to run stacked on the SAME pane as
// v3/pine/OBD_SecretTrader.pine (which already draws the real reference
// view tv_scraper reads) -- drawing its own boxes/lines/dots here would
// just be a duplicate of what that script already shows on the same
// pane, confirmed as visual clutter once both were added together.

//@version=5
indicator("OBD_Reversal v1.02"
  , overlay = true)
//------------------------------------------------------------------------------
//Settings
//-----------------------------------------------------------------------------{
length = input.int(5, 'Volume Pivot Length'
  , minval = 1)

mitigation = input.string('Wick', 'Mitigation Methods'
  , options = ['Wick', 'Close'])

webhook_secret = input.string('', 'Webhook Secret', group = 'Webhook')

//-----------------------------------------------------------------------------}
//Functions
//-----------------------------------------------------------------------------{
//Function to get order block coordinates
get_coordinates(condition, top, btm, ob_val)=>
    var ob_top  = array.new_float(0)
    var ob_btm  = array.new_float(0)
    var ob_avg  = array.new_float(0)
    var ob_left = array.new_int(0)
    // Parallel arrays for retest tracking -- ported from
    // v3/pine/OBD_SecretTrader.pine's own (already-proven) versions of
    // get_coordinates/mark_retests/remove_mitigated, added 2026-08-20 so
    // this webhook-push script can finally fire ob_zone_retested (it
    // previously only ever fired formed/mitigated -- see mark_retests()'s
    // own docstring below for why that's a real gap, not cosmetic, for
    // anything consuming these webhooks). Same meaning as the sibling
    // script: formation bar_index (a retest check skips the zone's own
    // formation bar), whether it's been retested yet, and the bar_index
    // it was retested on (na until then). No dot/label array here --
    // this script is headless (see module header), nothing gets drawn.
    var ob_formed_bar   = array.new_int(0)
    var ob_retested      = array.new_bool(0)
    var ob_retested_bar = array.new_int(0)

    float ob = na

    //Append coordinates to arrays
    if condition
        avg = math.avg(top, btm)

        array.unshift(ob_top, top)
        array.unshift(ob_btm, btm)
        array.unshift(ob_avg, avg)
        array.unshift(ob_left, time[length])
        array.unshift(ob_formed_bar, bar_index)
        array.unshift(ob_retested, false)
        array.unshift(ob_retested_bar, na)

        ob := ob_val

    [ob_top, ob_btm, ob_avg, ob_left, ob_formed_bar, ob_retested, ob_retested_bar, ob]

//Function to fire the ob_zone_retested webhook the first time a zone's
//range is actually touched by a later bar's wick (high/low overlap with
//[btm, top]) -- ported (logic unchanged, dot-drawing removed -- see
//module header) from v3/pine/OBD_SecretTrader.pine's own mark_retests(),
//2026-08-20. Runs on EVERY tick, not gated on barstate.isconfirmed: safe/
//non-repainting because a forming bar's high/low only ever EXPANDS as the
//bar progresses, never contracts, so once an intrabar tick satisfies the
//overlap check that fact can't un-happen no matter how the bar's eventual
//close lands (unlike mitigation below, which reads close/high/low as a
//genuinely moving target). The alert() call itself still uses
//freq_once_per_bar_close (not freq_all) -- same reasoning as the
//formation/mitigation alerts above: the retested_time in the payload is
//bar-scoped (`time`), so delaying delivery to this bar's close loses no
//accuracy, only avoids re-firing on every intrabar recalculation.
mark_retests(ob_top, ob_btm, ob_left, ob_avg, ob_formed_bar, ob_retested, ob_retested_bar, dir_label)=>
    retested_this_call = false
    // Guard against an empty array: Pine's `for i = 0 to array.size()-1`
    // does NOT skip the loop when size is 0 -- with end (-1) less than
    // start (0), Pine counts DOWNWARD instead, still running once with
    // i=0 against an empty array ("Index 0 is out of bounds, array size
    // is 0" at runtime). Every other loop over these arrays guards the
    // same way.
    if array.size(ob_top) > 0
        for i = 0 to array.size(ob_top) - 1
            // >= , not > : a candle whose OWN high/low overlaps the zone
            // it just formed now counts as retesting it on that same
            // candle too, not only from the next candle onward -- zone
            // geometry (top/btm come from hl2[length]/high[length]/
            // low[length], `length` bars back) is independent of the
            // CURRENT confirming bar's own high/low, so this is a real
            // retest, not a self-reference.
            if not array.get(ob_retested, i) and bar_index >= array.get(ob_formed_bar, i)
                z_top = array.get(ob_top, i)
                z_btm = array.get(ob_btm, i)

                if high >= z_btm and low <= z_top
                    array.set(ob_retested, i, true)
                    array.set(ob_retested_bar, i, bar_index)
                    retested_this_call := true

                    zone_start = array.get(ob_left, i)
                    retest_payload = '{"secret":"' + webhook_secret +
                      '","type":"ob_zone_retested","symbol":"' + syminfo.ticker +
                      '","timeframe":"' + timeframe.period +
                      '","direction":"' + dir_label +
                      '","start_time":' + str.tostring(math.round(zone_start / 1000), '#') +
                      ',"retested_time":' + str.tostring(math.round(time / 1000), '#') + '}'
                    alert(retest_payload, alert.freq_once_per_bar_close)

    retested_this_call

//Function to remove mitigated order blocks from coordinate arrays, firing a
//webhook per zone (with its identity/prices) right before it's removed --
//zone identity is its start_time, matching how the MT5 OB bridge identifies
//zones (see ob_bridge.reader.Zone / the "zone start_time, not detected_time"
//fix already applied on the MT5 side). Ported from OBD_SecretTrader.pine's
//own remove_mitigated() 2026-08-20 -- fixes two real bugs the old
//`for element in target_array` + `array.indexof` approach here had:
//  1. array.remove() INSIDE a for-in loop over the same array shifts
//     every later element's index down by one, but the loop doesn't know
//     that -- two zones mitigating on the same bar could silently land
//     on the wrong (shifted) index or skip an element entirely.
//  2. array.indexof(target_array, element) returns the FIRST index
//     matching that VALUE -- two zones can genuinely share the exact
//     same top/btm (a recurring round price level), which would target
//     the wrong zone's arrays.
//Fixed by walking real indices directly (never searching by value),
//collecting everything that qualifies first without mutating anything,
//then removing highest-index-first so each removal can never shift an
//index still waiting to be processed.
remove_mitigated(ob_top, ob_btm, ob_left, ob_avg, ob_formed_bar, ob_retested, ob_retested_bar, target, bull, dir_label, bar_time_sec)=>
    mitigated = false
    target_array = bull ? ob_btm : ob_top

    to_remove = array.new_int(0)
    if array.size(target_array) > 0
        for idx = 0 to array.size(target_array) - 1
            element = array.get(target_array, idx)
            if (bull ? target < element : target > element)
                array.push(to_remove, idx)

    if array.size(to_remove) > 0
        for i = array.size(to_remove) - 1 to 0
            idx = array.get(to_remove, i)
            mitigated := true

            zone_start = array.get(ob_left, idx)
            zone_top   = array.get(ob_top, idx)
            zone_btm   = array.get(ob_btm, idx)

            mit_payload = '{"secret":"' + webhook_secret +
              '","type":"ob_zone_mitigated","symbol":"' + syminfo.ticker +
              '","timeframe":"' + timeframe.period +
              '","direction":"' + dir_label +
              '","start_time":' + str.tostring(math.round(zone_start / 1000), '#') +
              ',"top":' + str.tostring(zone_top) +
              ',"btm":' + str.tostring(zone_btm) +
              ',"mitigated_time":' + str.tostring(bar_time_sec, '#') +
              ',"mitigated_price":' + str.tostring(target) + '}'

            // freq_once_per_bar_close (not freq_all -- see the matching
            // comment on the formation alerts below for why): confirmed
            // live 2026-07-31, freq_all fired the SAME mitigation 8 times
            // within under a second (one per script recalculation, not
            // once per real event).
            alert(mit_payload, alert.freq_once_per_bar_close)

            array.remove(ob_top, idx)
            array.remove(ob_btm, idx)
            array.remove(ob_avg, idx)
            array.remove(ob_left, idx)
            array.remove(ob_formed_bar, idx)
            array.remove(ob_retested, idx)
            array.remove(ob_retested_bar, idx)

    mitigated

//-----------------------------------------------------------------------------}
//Global elements
//-----------------------------------------------------------------------------{
var os = 0
var target_bull = 0.
var target_bear = 0.

upper = ta.highest(length)
lower = ta.lowest(length)

bar_time_sec = math.round(time / 1000)

if mitigation == 'Close'
    target_bull := ta.lowest(close, length)
    target_bear := ta.highest(close, length)
else
    target_bull := lower
    target_bear := upper

os := high[length] > upper ? 0 : low[length] < lower ? 1 : os[1]

phv = ta.pivothigh(volume, length, length)

//-----------------------------------------------------------------------------}
//Get bullish/bearish order blocks coordinates
//-----------------------------------------------------------------------------{
[bull_top
  , bull_btm
  , bull_avg
  , bull_left
  , bull_formed_bar
  , bull_retested
  , bull_retested_bar
  , bull_ob] = get_coordinates(phv and os == 1 and barstate.isconfirmed, hl2[length], low[length], low[length])

//Webhook: bullish OB just formed -- fire the full zone (top/btm/avg/start_time)
if not na(bull_ob)
    z_top   = array.get(bull_top, 0)
    z_btm   = array.get(bull_btm, 0)
    z_avg   = array.get(bull_avg, 0)
    z_start = array.get(bull_left, 0)
    bull_form_payload = '{"secret":"' + webhook_secret +
      '","type":"ob_zone_formed","symbol":"' + syminfo.ticker +
      '","timeframe":"' + timeframe.period +
      '","direction":"bull","start_time":' + str.tostring(math.round(z_start / 1000), '#') +
      ',"top":' + str.tostring(z_top) +
      ',"btm":' + str.tostring(z_btm) +
      ',"avg":' + str.tostring(z_avg) +
      ',"detected_time":' + str.tostring(bar_time_sec, '#') +
      // detected_price = live close at confirmation, NOT the zone's own
      // edge -- algo_v2's M3/M5 entry math (entries.py:m3_or_m5_entry)
      // reads this as "how far has price already run from ob_edge", which
      // is only ever true/non-negative if this is a real market price. The
      // OB detector's pivot confirmation lags `length` bars behind the
      // zone's own origin candle, so close here already reflects a real
      // (if small) run away from the zone -- exactly the concept this feeds.
      ',"detected_price":' + str.tostring(close) + '}'
    // freq_once_per_bar_close, not freq_all -- confirmed live 2026-07-31:
    // freq_all fired this exact same formation event 8 times within
    // under a second (once per script recalculation on the same closed
    // bar, not once per real formation). The condition itself is already
    // gated on barstate.isconfirmed so it's only ever true for one bar;
    // once_per_bar_close makes the ALERT match that too, matching
    // atr_trail_webhook.pine's own (already-correct) frequency.
    alert(bull_form_payload, alert.freq_once_per_bar_close)

[bear_top
  , bear_btm
  , bear_avg
  , bear_left
  , bear_formed_bar
  , bear_retested
  , bear_retested_bar
  , bear_ob] = get_coordinates(phv and os == 0 and barstate.isconfirmed, high[length], hl2[length], high[length])

//Webhook: bearish OB just formed
if not na(bear_ob)
    zb_top   = array.get(bear_top, 0)
    zb_btm   = array.get(bear_btm, 0)
    zb_avg   = array.get(bear_avg, 0)
    zb_start = array.get(bear_left, 0)
    bear_form_payload = '{"secret":"' + webhook_secret +
      '","type":"ob_zone_formed","symbol":"' + syminfo.ticker +
      '","timeframe":"' + timeframe.period +
      '","direction":"bear","start_time":' + str.tostring(math.round(zb_start / 1000), '#') +
      ',"top":' + str.tostring(zb_top) +
      ',"btm":' + str.tostring(zb_btm) +
      ',"avg":' + str.tostring(zb_avg) +
      ',"detected_time":' + str.tostring(bar_time_sec, '#') +
      // See the matching comment in the bullish branch above.
      ',"detected_price":' + str.tostring(close) + '}'
    // See the matching comment on the bullish branch above.
    alert(bear_form_payload, alert.freq_once_per_bar_close)

//-----------------------------------------------------------------------------}
//Mark retests (fires the ob_zone_retested webhook the first time a zone's
//range is actually touched) -- runs on EVERY tick, not gated on
//barstate.isconfirmed like mitigation below; see mark_retests()'s own
//docstring for why that's safe/non-repainting. Runs before mitigation
//removal below so a zone being fully mitigated on this same bar still
//gets its retest recorded first. Added 2026-08-20 -- see get_coordinates/
//mark_retests()'s own comments for why this webhook was missing before.
//-----------------------------------------------------------------------------{
retested_bull = mark_retests(bull_top, bull_btm, bull_left, bull_avg, bull_formed_bar, bull_retested, bull_retested_bar, "bull")
retested_bear = mark_retests(bear_top, bear_btm, bear_left, bear_avg, bear_formed_bar, bear_retested, bear_retested_bar, "bear")

//-----------------------------------------------------------------------------}
//Remove mitigated order blocks (fires ob_zone_mitigated webhooks internally)
//-- gated on barstate.isconfirmed for the same reason zone creation above
//is: target_bull/target_bear read close/high/low directly, which keep
//moving intrabar, so an unconfirmed check can flag (and remove) a zone on a
//wick that reverses before the bar actually closes.
//-----------------------------------------------------------------------------{
mitigated_bull = false
mitigated_bear = false

if barstate.isconfirmed
    mitigated_bull := remove_mitigated(bull_top
      , bull_btm
      , bull_left
      , bull_avg
      , bull_formed_bar
      , bull_retested
      , bull_retested_bar
      , target_bull
      , true
      , "bull"
      , bar_time_sec)

    mitigated_bear := remove_mitigated(bear_top
      , bear_btm
      , bear_left
      , bear_avg
      , bear_formed_bar
      , bear_retested
      , bear_retested_bar
      , target_bear
      , false
      , "bear"
      , bar_time_sec)

//-----------------------------------------------------------------------------}
//Alerts
//-----------------------------------------------------------------------------{
alertcondition(bull_ob, 'Bullish OB Formed', 'Bullish order block detected')

alertcondition(bear_ob, 'Bearish OB Formed', 'bearish order block detected')

alertcondition(mitigated_bull, 'Bullish OB Mitigated', 'Bullish order block mitigated')

alertcondition(mitigated_bear, 'Bearish OB Mitigated', 'bearish order block mitigated')

alertcondition(retested_bull, 'Bullish OB Retested', 'Bullish order block retested')

alertcondition(retested_bear, 'Bearish OB Retested', 'bearish order block retested')

// NOTE: these alertcondition() entries are for the alert dialog's dropdown
// discoverability only -- they do NOT carry the JSON webhook payload. When
// creating the actual TradingView alert against this script, the
// condition must be "Any alert() function call", not one of these named
// entries, or the ob_zone_formed/mitigated/retested JSON this script
// builds above never gets sent.
//-----------------------------------------------------------------------------}
