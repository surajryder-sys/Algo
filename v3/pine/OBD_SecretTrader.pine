//@version=5
// Build 5.06 -- bump this on every change (5.07, 5.08, ...) so the title
// bar shows which version is actually live on the chart, at a glance.
indicator("OBD_SecretTrader 5.06"
  , overlay = true
  , max_boxes_count = 500
  , max_labels_count = 500
  , max_lines_count = 500)
// Dynamic (runtime-computed, not a literal constant) offsets into time[]
// -- used below by seconds_since_formed()/seconds_since_retested() -- need
// this explicit declaration so Pine allocates enough history buffer;
// without it, a zone formed further back than Pine's auto-detected default
// can error with "requesting too much historical data" at runtime.
// Confirmed live zones already reach ~2000+ bars back on M1, so sized well
// above that with headroom.
max_bars_back(time, 5000)
//------------------------------------------------------------------------------
//Settings
//-----------------------------------------------------------------------------{
length = input.int(5, 'Volume Pivot Length'
  , minval = 1)

bull_ext_last = input.int(4, 'Bullish OB '
  , minval = 1
  , inline = 'bull')

bg_bull_css = input.color(color.new(#169400, 80), ''
  , inline = 'bull')

bull_css = input.color(#169400, ''
  , inline = 'bull')

bull_avg_css = input.color(color.new(#9598a1, 37), ''
  , inline = 'bull')

bear_ext_last = input.int(4, 'Bearish OB'
  , minval = 1
  , inline = 'bear')

bg_bear_css = input.color(color.new(#ff1100, 80), ''
  , inline = 'bear')

bear_css = input.color(#ff1100, ''
  , inline = 'bear')

bear_avg_css = input.color(color.new(#9598a1, 37), ''
  , inline = 'bear')

line_style = input.string('⎯⎯⎯', 'Average Line Style'
  , options = ['⎯⎯⎯', '----', '····'])

line_width = input.int(1, 'Average Line Width'
  , minval = 1)

mitigation = input.string('Wick', 'Mitigation Methods'
  , options = ['Wick', 'Close'])

webhook_secret = input.string('', 'Webhook Secret', group = 'Webhook')

//-----------------------------------------------------------------------------}
//Functions
//-----------------------------------------------------------------------------{
//Line Style function
get_line_style(style) =>
    out = switch style
        '⎯⎯⎯'  => line.style_solid
        '----' => line.style_dashed
        '····' => line.style_dotted

//Function to get order block coordinates
get_coordinates(condition, top, btm, ob_val)=>
    var ob_top  = array.new_float(0)
    var ob_btm  = array.new_float(0)
    var ob_avg  = array.new_float(0)
    var ob_left = array.new_int(0)
    // Parallel arrays for retest tracking: formation bar_index (so a
    // retest check can skip the zone's own formation bar), whether it's
    // been retested yet, the bar_index it was retested on (na until then),
    // and the yellow dot label marking that moment -- kept alongside the
    // coordinate arrays so the SAME index in every array always refers to
    // the same zone.
    var ob_formed_bar   = array.new_int(0)
    var ob_retested      = array.new_bool(0)
    var ob_retested_bar = array.new_int(0)
    var ob_dot            = array.new_label(0)

    float ob = na

    //Append coordinates to arrays
    if condition
        avg = math.avg(top, btm)

        array.unshift(ob_top, top)
        array.unshift(ob_btm, btm)
        array.unshift(ob_avg, avg)
        array.unshift(ob_left, time[length])
        array.unshift(ob_formed_bar, bar_index)
        array.unshift(ob_retested, false)
        array.unshift(ob_retested_bar, na)
        array.unshift(ob_dot, na)

        ob := ob_val

    [ob_top, ob_btm, ob_avg, ob_left, ob_formed_bar, ob_retested, ob_retested_bar, ob_dot, ob]

//Function to place a yellow dot the first time a zone's range is actually
//touched by a later bar's wick (high/low overlap with [btm, top]) -- the
//formation bar itself is always skipped, matching the MT5 indicator's own
//retest logic (which excludes its own detection bar for the same reason:
//the bar that CREATES a zone shouldn't count as retesting it). Runs on
//every tick, checking every zone still being tracked. Also fires an
//ob_zone_retested webhook carrying the EXACT retest time (`time`, this
//tick's bar) -- the Data Window can't carry that (a raw timestamp value
//breaks this chart's price-scale autoscale, same issue start_time already
//has -- see the Data Window plot section's own comment), but an alert
//payload is just JSON over HTTP, nothing to do with chart rendering, so
//it's completely unaffected. Mirrors how ob_zone_formed/ob_zone_mitigated
//already carry their own real timestamps the same way.
mark_retests(ob_top, ob_btm, ob_left, ob_avg, ob_formed_bar, ob_retested, ob_retested_bar, ob_dot, dir_label)=>
    retested_this_call = false
    // Guard against an empty array: Pine's `for i = 0 to array.size()-1`
    // does NOT skip the loop when size is 0 -- with end (-1) less than
    // start (0), Pine counts DOWNWARD instead, still running once with
    // i=0 against an empty array (confirmed live: "Index 0 is out of
    // bounds, array size is 0" at runtime). Every other loop over these
    // arrays elsewhere in this script already guards the same way.
    if array.size(ob_top) > 0
        for i = 0 to array.size(ob_top) - 1
            // >= , not > : a candle whose OWN high/low overlaps the zone it
            // just formed now counts as retesting it on that same candle,
            // not only from the next candle onward. Previously excluded the
            // formation bar entirely (matching the MT5 indicator's rule
            // that a zone's creation can't count as its own retest) -- but
            // confirmed live that zone geometry (top/btm come from
            // hl2[length]/high[length]/low[length], data from `length`
            // bars back, independent of the CURRENT confirming bar's own
            // high/low) can genuinely have the current bar wick back into
            // its own just-formed range, and that's a real retest the user
            // wants reflected on the correct candle, not deferred one bar.
            if not array.get(ob_retested, i) and bar_index >= array.get(ob_formed_bar, i)
                z_top = array.get(ob_top, i)
                z_btm = array.get(ob_btm, i)

                if high >= z_btm and low <= z_top
                    array.set(ob_retested, i, true)
                    array.set(ob_retested_bar, i, bar_index)
                    retested_this_call := true

                    zone_start = array.get(ob_left, i)
                    retest_payload = '{"secret":"' + webhook_secret +
                      '","type":"ob_zone_retested","symbol":"' + syminfo.ticker +
                      '","timeframe":"' + timeframe.period +
                      '","direction":"' + dir_label +
                      '","start_time":' + str.tostring(math.round(zone_start / 1000), '#') +
                      ',"retested_time":' + str.tostring(math.round(time / 1000), '#') + '}'
                    alert(retest_payload, alert.freq_all)

                    // style_none + a single bullet character, no
                    // background shape at all -- label.style_circle's
                    // filled circle has a much larger fixed footprint
                    // than this even at size.tiny (confirmed live: still
                    // looked "3x too big"). size.tiny/small both then
                    // looked too small -- size.large is the next step up,
                    // still with no background shape.
                    dot = label.new(time, array.get(ob_avg, i)
                      , text = '•'
                      , xloc = xloc.bar_time
                      , yloc = yloc.price
                      , textcolor = color.yellow
                      , style = label.style_none
                      , size = size.large)
                    array.set(ob_dot, i, dot)

    retested_this_call

//Function to remove mitigated order blocks from coordinate arrays, firing a
//webhook per zone (with its identity/prices) right before it's removed --
//zone identity is its start_time, matching how the MT5 OB bridge identifies
//zones (see ob_bridge.reader.Zone / the "zone start_time, not detected_time"
//fix already applied on the MT5 side).
remove_mitigated(ob_top, ob_btm, ob_left, ob_avg, ob_formed_bar, ob_retested, ob_retested_bar, ob_dot, target, bull, dir_label, bar_time_sec)=>
    mitigated = false
    target_array = bull ? ob_btm : ob_top

    // Two bugs in the old `for element in target_array` + `array.indexof`
    // approach, both confirmed live as the cause of retest dots surviving
    // their own zone's mitigation:
    //   1. array.remove() INSIDE a for-in loop over the same array shifts
    //      every later element's index down by one, but the loop doesn't
    //      know that -- when two zones mitigate on the same bar, the
    //      second removal can silently land on the wrong (shifted) index
    //      or skip an element entirely.
    //   2. array.indexof(target_array, element) returns the FIRST index
    //      matching that VALUE -- two zones can genuinely share the exact
    //      same top/btm (a recurring round price level), which would
    //      target the wrong zone's arrays.
    // Fixed by walking real indices directly (never searching by value),
    // collecting everything that qualifies first without mutating
    // anything, then removing highest-index-first so each removal can
    // never shift an index still waiting to be processed.
    to_remove = array.new_int(0)
    if array.size(target_array) > 0
        for idx = 0 to array.size(target_array) - 1
            element = array.get(target_array, idx)
            if (bull ? target < element : target > element)
                array.push(to_remove, idx)

    if array.size(to_remove) > 0
        for i = array.size(to_remove) - 1 to 0
            idx = array.get(to_remove, i)
            mitigated := true

            zone_start = array.get(ob_left, idx)
            zone_top   = array.get(ob_top, idx)
            zone_btm   = array.get(ob_btm, idx)

            mit_payload = '{"secret":"' + webhook_secret +
              '","type":"ob_zone_mitigated","symbol":"' + syminfo.ticker +
              '","timeframe":"' + timeframe.period +
              '","direction":"' + dir_label +
              '","start_time":' + str.tostring(math.round(zone_start / 1000), '#') +
              ',"top":' + str.tostring(zone_top) +
              ',"btm":' + str.tostring(zone_btm) +
              ',"mitigated_time":' + str.tostring(bar_time_sec, '#') +
              ',"mitigated_price":' + str.tostring(target) + '}'

            alert(mit_payload, alert.freq_all)

            // Delete this zone's retest dot (if it ever got one) the
            // moment the zone itself is removed -- a leftover dot with no
            // zone behind it would be confusing/misleading on the chart.
            existing_dot = array.get(ob_dot, idx)
            if not na(existing_dot)
                label.delete(existing_dot)

            array.remove(ob_top, idx)
            array.remove(ob_btm, idx)
            array.remove(ob_avg, idx)
            array.remove(ob_left, idx)
            array.remove(ob_formed_bar, idx)
            array.remove(ob_retested, idx)
            array.remove(ob_retested_bar, idx)
            array.remove(ob_dot, idx)

    mitigated

//Function to set order blocks
set_order_blocks(ob_top, ob_btm, ob_left, ob_avg, ob_dot, ext_last, bg_css, border_css, lvl_css)=>
    var ob_box = array.new_box(0)
    var ob_lvl = array.new_line(0)

    //Fill arrays with boxes/lines
    if barstate.isfirst
        for i = 0 to ext_last-1
            array.unshift(ob_box, box.new(na,na,na,na
              , xloc = xloc.bar_time
              , extend= extend.right
              , bgcolor = bg_css
              , border_color = color.new(border_css, 70)))

            array.unshift(ob_lvl, line.new(na,na,na,na
              , xloc = xloc.bar_time
              , extend = extend.right
              , color = lvl_css
              , style = get_line_style(line_style)
              , width = line_width))

    //Set order blocks
    if barstate.islast
        if array.size(ob_top) > 0
            for i = 0 to math.min(ext_last-1, array.size(ob_top)-1)
                get_box = array.get(ob_box, i)
                get_lvl = array.get(ob_lvl, i)

                box.set_lefttop(get_box, array.get(ob_left, i), array.get(ob_top, i))
                box.set_rightbottom(get_box, array.get(ob_left, i), array.get(ob_btm, i))

                line.set_xy1(get_lvl, array.get(ob_left, i), array.get(ob_avg, i))
                line.set_xy2(get_lvl, array.get(ob_left, i)+1, array.get(ob_avg, i))

        // Any zone beyond the visible ext_last window has no box drawn for
        // it (the loop above only ever touches indices 0..ext_last-1) --
        // confirmed live: a zone that's genuinely still unmitigated but got
        // pushed past this window by newer zones forming keeps its retest
        // dot forever (mark_retests() isn't limited by ext_last at all, it
        // walks the FULL array), which looks exactly like an orphaned dot
        // even though the zone was never actually mitigated. Deleting the
        // dot here the moment a zone falls out of the visible window keeps
        // "a dot only exists while its zone has a visible box" true in
        // both directions, not just on real mitigation.
        if array.size(ob_top) > ext_last
            for i = ext_last to array.size(ob_top) - 1
                stale_dot = array.get(ob_dot, i)
                if not na(stale_dot)
                    label.delete(stale_dot)
                    array.set(ob_dot, i, na)


//-----------------------------------------------------------------------------}
//Global elements
//-----------------------------------------------------------------------------{
var os = 0
var target_bull = 0.
var target_bear = 0.

n = bar_index
upper = ta.highest(length)
lower = ta.lowest(length)

bar_time_sec = math.round(time / 1000)

if mitigation == 'Close'
    target_bull := ta.lowest(close, length)
    target_bear := ta.highest(close, length)
else
    target_bull := lower
    target_bear := upper

os := high[length] > upper ? 0 : low[length] < lower ? 1 : os[1]

phv = ta.pivothigh(volume, length, length)

//-----------------------------------------------------------------------------}
//Get bullish/bearish order blocks coordinates
//-----------------------------------------------------------------------------{
[bull_top
  , bull_btm
  , bull_avg
  , bull_left
  , bull_formed_bar
  , bull_retested
  , bull_retested_bar
  , bull_dot
  , bull_ob] = get_coordinates(phv and os == 1 and barstate.isconfirmed, hl2[length], low[length], low[length])

//Webhook: bullish OB just formed -- fire the full zone (top/btm/avg/start_time)
if not na(bull_ob)
    z_top   = array.get(bull_top, 0)
    z_btm   = array.get(bull_btm, 0)
    z_avg   = array.get(bull_avg, 0)
    z_start = array.get(bull_left, 0)
    bull_form_payload = '{"secret":"' + webhook_secret +
      '","type":"ob_zone_formed","symbol":"' + syminfo.ticker +
      '","timeframe":"' + timeframe.period +
      '","direction":"bull","start_time":' + str.tostring(math.round(z_start / 1000), '#') +
      ',"top":' + str.tostring(z_top) +
      ',"btm":' + str.tostring(z_btm) +
      ',"avg":' + str.tostring(z_avg) +
      ',"detected_time":' + str.tostring(bar_time_sec, '#') +
      // detected_price = live close at confirmation, NOT the zone's own
      // edge -- algo_v2's M3/M5 entry math (entries.py:m3_or_m5_entry)
      // reads this as "how far has price already run from ob_edge", which
      // is only ever true/non-negative if this is a real market price.
      ',"detected_price":' + str.tostring(close) + '}'
    alert(bull_form_payload, alert.freq_all)

[bear_top
  , bear_btm
  , bear_avg
  , bear_left
  , bear_formed_bar
  , bear_retested
  , bear_retested_bar
  , bear_dot
  , bear_ob] = get_coordinates(phv and os == 0 and barstate.isconfirmed, high[length], hl2[length], high[length])

//Webhook: bearish OB just formed
if not na(bear_ob)
    zb_top   = array.get(bear_top, 0)
    zb_btm   = array.get(bear_btm, 0)
    zb_avg   = array.get(bear_avg, 0)
    zb_start = array.get(bear_left, 0)
    bear_form_payload = '{"secret":"' + webhook_secret +
      '","type":"ob_zone_formed","symbol":"' + syminfo.ticker +
      '","timeframe":"' + timeframe.period +
      '","direction":"bear","start_time":' + str.tostring(math.round(zb_start / 1000), '#') +
      ',"top":' + str.tostring(zb_top) +
      ',"btm":' + str.tostring(zb_btm) +
      ',"avg":' + str.tostring(zb_avg) +
      ',"detected_time":' + str.tostring(bar_time_sec, '#') +
      // See the matching comment in the bullish branch above.
      ',"detected_price":' + str.tostring(close) + '}'
    alert(bear_form_payload, alert.freq_all)

//-----------------------------------------------------------------------------}
//Mark retests (yellow dot the first time a zone's range is actually
//touched) -- runs on EVERY tick, not gated on barstate.isconfirmed like
//mitigation below. Safe to do live/non-repainting: a forming bar's high/
//low only ever EXPANDS as the bar progresses, never contracts, so once an
//intrabar tick satisfies the overlap check that fact can't un-happen no
//matter how the bar's eventual close lands -- unlike mitigation, which
//reads close/high/low as a MOVING target that genuinely can reverse
//before the bar closes (see that gate's own comment). Also runs before
//mitigation removal below so a zone being fully mitigated on this same
//bar still gets its retest recorded first.
//-----------------------------------------------------------------------------{
retested_bull = mark_retests(bull_top, bull_btm, bull_left, bull_avg, bull_formed_bar, bull_retested, bull_retested_bar, bull_dot, "bull")
retested_bear = mark_retests(bear_top, bear_btm, bear_left, bear_avg, bear_formed_bar, bear_retested, bear_retested_bar, bear_dot, "bear")

//-----------------------------------------------------------------------------}
//Remove mitigated order blocks (fires ob_zone_mitigated webhooks internally)
//-- gated on barstate.isconfirmed for the same reason zone creation above
//is: target_bull/target_bear read close/high/low directly, which keep
//moving intrabar, so an unconfirmed check can flag (and remove) a zone on a
//wick that reverses before the bar actually closes.
//-----------------------------------------------------------------------------{
mitigated_bull = false
mitigated_bear = false

if barstate.isconfirmed
    mitigated_bull := remove_mitigated(bull_top
      , bull_btm
      , bull_left
      , bull_avg
      , bull_formed_bar
      , bull_retested
      , bull_retested_bar
      , bull_dot
      , target_bull
      , true
      , "bull"
      , bar_time_sec)

    mitigated_bear := remove_mitigated(bear_top
      , bear_btm
      , bear_left
      , bear_avg
      , bear_formed_bar
      , bear_retested
      , bear_retested_bar
      , bear_dot
      , target_bear
      , false
      , "bear"
      , bar_time_sec)

//-----------------------------------------------------------------------------}
//Display order blocks
//-----------------------------------------------------------------------------{
//Set bullish order blocks
set_order_blocks(bull_top
  , bull_btm
  , bull_left
  , bull_avg
  , bull_dot
  , bull_ext_last
  , bg_bull_css
  , bull_css
  , bull_avg_css)

//Set bearish order blocks
set_order_blocks(bear_top
  , bear_btm
  , bear_left
  , bear_avg
  , bear_dot
  , bear_ext_last
  , bg_bear_css
  , bear_css
  , bear_avg_css)

//Show detected order blocks
plot(bull_ob, 'Bull OB', bull_css, 2, plot.style_linebr
  , offset = -length
  , display = display.none)

plot(bear_ob, 'Bear OB', bear_css, 2, plot.style_linebr
  , offset = -length
  , display = display.none)

//-----------------------------------------------------------------------------}
//Zone coordinates exposed via Data Window -- tv_scraper polls these directly
//(pull) instead of relying on the alert() calls above (push). 4 slots per
//direction exposed here, matching bull_ext_last/bear_ext_last (4) exactly
//-- deliberately kept 1:1 with what's actually drawn on the chart, so the
//Data Window never shows anything the user can't also see as a box.
//
//This WAS raised to 8 for a while (tv_scraper could see 4 extra "backup"
//zones beyond what's drawn, so a real zone ranked 5th-8th wouldn't get
//misread as mitigated just for falling out of the visible top-4 -- see
//scraper.py's mitigation-debounce comment for the failure mode that
//protected against). Reverted back to 4 by explicit request: only expose
//what's actually visible on the chart, full stop -- accepting that
//top-4-churn misreads (a real zone briefly read as mitigated purely
//because newer zones pushed it out of the visible slots, not because
//price actually broke it) can happen again as a result.
//
//Top/Btm only -- NOT start_time. start_time is a raw unix-ms value (~1.78e12)
//and plotting it here once visibly broke this chart's price scale (boxes
//jumped around) despite display.data_window supposedly excluding a plot from
//the chart entirely. Top/Btm are normal price-magnitude numbers, same order
//as everything else already plotted, so they're safe. tv_scraper derives a
//stable per-zone identity from (top, btm) instead of a real timestamp -- see
//tv_scraper/scraper.py.
//-----------------------------------------------------------------------------{
plot(array.size(bull_top) > 0 ? array.get(bull_top, 0) : na, "Bull1 Top", display = display.data_window)
plot(array.size(bull_top) > 0 ? array.get(bull_btm, 0) : na, "Bull1 Btm", display = display.data_window)
plot(array.size(bull_top) > 1 ? array.get(bull_top, 1) : na, "Bull2 Top", display = display.data_window)
plot(array.size(bull_top) > 1 ? array.get(bull_btm, 1) : na, "Bull2 Btm", display = display.data_window)
plot(array.size(bull_top) > 2 ? array.get(bull_top, 2) : na, "Bull3 Top", display = display.data_window)
plot(array.size(bull_top) > 2 ? array.get(bull_btm, 2) : na, "Bull3 Btm", display = display.data_window)
plot(array.size(bear_top) > 0 ? array.get(bear_top, 0) : na, "Bear1 Top", display = display.data_window)
plot(array.size(bear_top) > 0 ? array.get(bear_btm, 0) : na, "Bear1 Btm", display = display.data_window)
plot(array.size(bear_top) > 1 ? array.get(bear_top, 1) : na, "Bear2 Top", display = display.data_window)
plot(array.size(bear_top) > 1 ? array.get(bear_btm, 1) : na, "Bear2 Btm", display = display.data_window)
plot(array.size(bear_top) > 2 ? array.get(bear_top, 2) : na, "Bear3 Top", display = display.data_window)
plot(array.size(bear_top) > 2 ? array.get(bear_btm, 2) : na, "Bear3 Btm", display = display.data_window)
plot(array.size(bull_top) > 3 ? array.get(bull_top, 3) : na, "Bull4 Top", display = display.data_window)
plot(array.size(bull_top) > 3 ? array.get(bull_btm, 3) : na, "Bull4 Btm", display = display.data_window)
plot(array.size(bear_top) > 3 ? array.get(bear_top, 3) : na, "Bear4 Top", display = display.data_window)
plot(array.size(bear_top) > 3 ? array.get(bear_btm, 3) : na, "Bear4 Btm", display = display.data_window)
//-----------------------------------------------------------------------------}
//Retest status per slot -- 1 = retested (a later bar's wick has touched
//this zone's range), 0 = still virgin. This is the SAME wick-based check
//that places the yellow dot, exposed as a number so tv_scraper can read it
//directly instead of approximating retest from live Close alone (which
//can miss a wick that touches and reverses between polls).
retested_num(arr, i) =>
    array.size(arr) > i ? (array.get(arr, i) ? 1 : 0) : na

plot(retested_num(bull_retested, 0), "Bull1 Retested", display = display.data_window)
plot(retested_num(bull_retested, 1), "Bull2 Retested", display = display.data_window)
plot(retested_num(bull_retested, 2), "Bull3 Retested", display = display.data_window)
plot(retested_num(bull_retested, 3), "Bull4 Retested", display = display.data_window)
plot(retested_num(bear_retested, 0), "Bear1 Retested", display = display.data_window)
plot(retested_num(bear_retested, 1), "Bear2 Retested", display = display.data_window)
plot(retested_num(bear_retested, 2), "Bear3 Retested", display = display.data_window)
plot(retested_num(bear_retested, 3), "Bear4 Retested", display = display.data_window)
//-----------------------------------------------------------------------------}
//Real ELAPSED SECONDS since formation / since retest, per slot -- computed
//directly from Pine's own timenow (true real time, independent of how
//delayed the underlying price FEED itself might be, e.g. a broker CFD feed
//running a few minutes behind the real market) against the formation/
//retest bar's own real timestamp (time[]).
//
//Replaces the earlier bars-ago-COUNT approach (bars_since_formed()/
//bars_since_retested()): tv_scraper reconstructed a real timestamp from
//that as `now - bars_ago * timeframe_seconds`, using ITS OWN wall clock
//for `now`. That's silently wrong by however much the price feed is
//delayed -- bar_index/bars_ago is anchored to the FEED's own (possibly
//stale) notion of "the current bar", not true real time, so subtracting
//from tv_scraper's TRUE wall clock introduced a systematic offset equal
//to the feed's delay on every reconstructed historical timestamp.
//Confirmed live: recent/live data (Close, read directly every poll) lined
//up fine, but detected/retested_at timestamps for OLDER zones visibly
//disagreed with the chart's own marked positions.
//
//timenow doesn't have this problem -- it's Pine's own true current time
//regardless of how stale the chart's price data is -- so doing the
//subtraction entirely inside Pine sidesteps the mismatch instead of
//requiring tv_scraper to somehow measure/correct for the feed's delay
//itself. Still a small, bounded number of SECONDS (not a raw ~1.78e12
//epoch value), same reasoning as the bar-count version for why this is
//safe to plot without breaking this chart's price-scale autoscale (see
//the zone-coordinates plot section above).
//
//time[n] (n bars back from the current bar) gives that bar's own real
//timestamp; bar_index - array.get(formed_bar_arr, i) is the same offset
//bars_since_formed() used to compute a bar COUNT, reused here as the
//history-referencing offset instead. Needs max_bars_back(time, ...) up
//top since this offset is a runtime-computed value, not a literal.
//
//The [] operator has its OWN hard ceiling of 10000 bars back regardless
//of max_bars_back (which only controls buffer allocation, not this
//limit) -- confirmed live: "RE10007 ... accepts a value between 0 and
//10000" on a zone that had stayed unmitigated long enough to exceed it
//(easily reached on M1 -- 10000 bars is under 7 days). Guarding the
//upper bound too, not just offset >= 0, and simply leaving the result na
//for a zone that old -- tv_scraper already falls back to its older
//wall-clock approximation when this field is missing, same as it does
//for an indicator build that predates these plots entirely.
seconds_since_formed(formed_bar_arr, i) =>
    // Statement-level if, not a ternary -- confirmed live: Pine does NOT
    // reliably short-circuit `condition and array.get(...)` or
    // `condition ? array.get(...) : na` the way an imperative language
    // would; array.get() still gets evaluated (and errors: "Index 0 is
    // out of bounds, array size is 0") on bar 0 when the array is still
    // empty, even though the size check ahead of it is false. An actual
    // `if` block, matching every other array-guard already in this
    // script (see mark_retests()' own comment on this), avoids it.
    int result = na
    if array.size(formed_bar_arr) > i
        formed_bar = array.get(formed_bar_arr, i)
        offset = bar_index - formed_bar
        if offset >= 0 and offset <= 10000
            result := int((timenow - time[offset]) / 1000)
    result

seconds_since_retested(retested_bar_arr, i) =>
    int result = na
    if array.size(retested_bar_arr) > i
        bar_at_retest = array.get(retested_bar_arr, i)
        if not na(bar_at_retest)
            offset = bar_index - bar_at_retest
            if offset >= 0 and offset <= 10000
                result := int((timenow - time[offset]) / 1000)
    result

plot(seconds_since_formed(bull_formed_bar, 0), "Bull1 FormedSecondsAgo", display = display.data_window)
plot(seconds_since_formed(bull_formed_bar, 1), "Bull2 FormedSecondsAgo", display = display.data_window)
plot(seconds_since_formed(bull_formed_bar, 2), "Bull3 FormedSecondsAgo", display = display.data_window)
plot(seconds_since_formed(bull_formed_bar, 3), "Bull4 FormedSecondsAgo", display = display.data_window)
plot(seconds_since_formed(bear_formed_bar, 0), "Bear1 FormedSecondsAgo", display = display.data_window)
plot(seconds_since_formed(bear_formed_bar, 1), "Bear2 FormedSecondsAgo", display = display.data_window)
plot(seconds_since_formed(bear_formed_bar, 2), "Bear3 FormedSecondsAgo", display = display.data_window)
plot(seconds_since_formed(bear_formed_bar, 3), "Bear4 FormedSecondsAgo", display = display.data_window)

plot(seconds_since_retested(bull_retested_bar, 0), "Bull1 RetestedSecondsAgo", display = display.data_window)
plot(seconds_since_retested(bull_retested_bar, 1), "Bull2 RetestedSecondsAgo", display = display.data_window)
plot(seconds_since_retested(bull_retested_bar, 2), "Bull3 RetestedSecondsAgo", display = display.data_window)
plot(seconds_since_retested(bull_retested_bar, 3), "Bull4 RetestedSecondsAgo", display = display.data_window)
plot(seconds_since_retested(bear_retested_bar, 0), "Bear1 RetestedSecondsAgo", display = display.data_window)
plot(seconds_since_retested(bear_retested_bar, 1), "Bear2 RetestedSecondsAgo", display = display.data_window)
plot(seconds_since_retested(bear_retested_bar, 2), "Bear3 RetestedSecondsAgo", display = display.data_window)
plot(seconds_since_retested(bear_retested_bar, 3), "Bear4 RetestedSecondsAgo", display = display.data_window)
//-----------------------------------------------------------------------------}
//Alerts
//-----------------------------------------------------------------------------{
alertcondition(bull_ob, 'Bullish OB Formed', 'Bullish order block detected')

alertcondition(bear_ob, 'Bearish OB Formed', 'bearish order block detected')

alertcondition(mitigated_bull, 'Bullish OB Mitigated', 'Bullish order block mitigated')

alertcondition(mitigated_bear, 'Bearish OB Mitigated', 'bearish order block mitigated')

alertcondition(retested_bull, 'Bullish OB Retested', 'Bullish order block retested')

alertcondition(retested_bear, 'Bearish OB Retested', 'bearish order block retested')

//-----------------------------------------------------------------------------}
