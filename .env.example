# ---------------------------------------------------------------------------
BTC_SMC_MT5_LOGIN=
BTC_SMC_MT5_PASSWORD=
BTC_SMC_MT5_SERVER=
BTC_SMC_MT5_TERMINAL_PATH=C:\Program Files\MetaTrader5-4\terminal64.exe

BTC_SMC_SYMBOL=BTCUSD
BTC_SMC_LOTS=0.05
BTC_SMC_MAGIC_NUMBER=26072801
BTC_SMC_DEVIATION_POINTS=30
BTC_SMC_POLL_SECONDS=1

# Must be explicitly "true" for any order to actually be sent/modified/
# cancelled. Left unset (default false), every decision is printed but
# nothing touches the account.
BTC_SMC_ENABLE_TRADING=false

BTC_SMC_STATE_FILE=btc_smc_bot_state.json
BTC_SMC_BLOCKED_STATE_FILE=btc_smc_bot_blocks.json
BTC_SMC_ALERT_STATE_FILE=btc_smc_bot_alerts.json

# ---------------------------------------------------------------------------
# algo_v2_usoil (SMC USOIL bot, Order Block + ATR Trail zone rules,
# M5+M15 execution tiers -- M30 to follow), reads the OB bridge published
# by mql5/OB_State_USOIL_2.0.mq5 -- fully independent from algo_v2
# (XAUUSD): its own MT5 terminal connection (a separate terminal install,
# so it never touches the XAUUSD terminal that's already running), own
# login/credentials, own magic number/state/block files.
# PRESERVED STANDALONE SNAPSHOT: this is USOIL running on its own, kept
# exactly as it was before being merged into algo_v2_usoil_btc_eth below
# -- ready to run independently again if ever needed. Not the active
# config; algo_v2_usoil_btc_eth is what actually runs USOIL day-to-day now.
# Run with: python -m algo_v2_usoil.main
# ---------------------------------------------------------------------------
SMC_V2_USOIL_MT5_LOGIN=
SMC_V2_USOIL_MT5_PASSWORD=
SMC_V2_USOIL_MT5_SERVER=
SMC_V2_USOIL_MT5_TERMINAL_PATH=C:\Program Files\MetaTrader5-3\terminal64.exe

SMC_V2_USOIL_SYMBOL=USOIL
SMC_V2_USOIL_LOTS=0.01
SMC_V2_USOIL_MAGIC_NUMBER=26080501
SMC_V2_USOIL_DEVIATION_POINTS=30
SMC_V2_USOIL_POLL_SECONDS=1
SMC_V2_USOIL_ATR_TIMEFRAME_MINUTES=15

# Must be explicitly "true" for any order to actually be sent/modified/
# cancelled. Left unset (default false), every decision is printed but
# nothing touches the account.
SMC_V2_USOIL_ENABLE_TRADING=false

SMC_V2_USOIL_STATE_FILE=smc_v2_usoil_bot_state.json
SMC_V2_USOIL_BLOCKED_STATE_FILE=smc_v2_usoil_bot_blocks.json

# ---------------------------------------------------------------------------
# algo_v2_usoil_btc_eth (SMC USOIL+BTCUSD+ETHUSD bot, Order Block + ATR
# Trail zone rules, M5+M15 execution tiers -- M30 to follow per symbol),
# reads the OB bridge published by mql5/OB_State_Multi_2.0.mq5 (same
# compiled indicator attached to all three symbols' own M5+M15 charts,
# each instance either left on BridgeSymbol="" -- uses that chart's own
# symbol -- or overridden explicitly). ONE merged process, ONE shared MT5
# connection for all three symbols (deliberately -- avoids three separate
# IPC connections to what would be the same terminal anyway) -- fully
# independent from algo_v2 (XAUUSD) and from the preserved standalone
# algo_v2_usoil above: its own terminal install, own login/credentials,
# own per-symbol magic number/state/block files. There's no per-symbol
# trading toggle -- ENABLE_TRADING is all three symbols or none. This is
# the ACTIVE config for USOIL day-to-day, not the standalone one above.
# Run with: python -m algo_v2_usoil_btc_eth.main
# ---------------------------------------------------------------------------
SMC_V2_MULTI_MT5_LOGIN=
SMC_V2_MULTI_MT5_PASSWORD=
SMC_V2_MULTI_MT5_SERVER=
SMC_V2_MULTI_MT5_TERMINAL_PATH=C:\Program Files\MetaTrader5-5\terminal64.exe
SMC_V2_MULTI_POLL_SECONDS=1

# Must be explicitly "true" for any order (on ANY of the three symbols) to
# actually be sent/modified/cancelled. Left unset (default false), every
# decision is printed but nothing touches any account.
SMC_V2_MULTI_ENABLE_TRADING=false

SMC_V2_BTC_SYMBOL=BTCUSD
SMC_V2_BTC_LOTS=0.01
SMC_V2_BTC_MAGIC_NUMBER=26080801
SMC_V2_BTC_DEVIATION_POINTS=30
SMC_V2_BTC_ATR_TIMEFRAME_MINUTES=15
SMC_V2_BTC_STATE_FILE=smc_v2_btcusd_bot_state.json
SMC_V2_BTC_BLOCKED_STATE_FILE=smc_v2_btcusd_bot_blocks.json

SMC_V2_ETH_SYMBOL=ETHUSD
SMC_V2_ETH_LOTS=0.1
SMC_V2_ETH_MAGIC_NUMBER=26080802
SMC_V2_ETH_DEVIATION_POINTS=30
SMC_V2_ETH_ATR_TIMEFRAME_MINUTES=15
SMC_V2_ETH_STATE_FILE=smc_v2_ethusd_bot_state.json
SMC_V2_ETH_BLOCKED_STATE_FILE=smc_v2_ethusd_bot_blocks.json

# Note: algo_v2_usoil_btc_eth's config.py falls back to
# SMC_V2_USOIL_MT5_TERMINAL_PATH above and reuses the SMC_V2_USOIL_* names
# for its own USOIL entry (lots/magic/state files) if the newer
# SMC_V2_MULTI_*/dedicated names aren't set -- see config.py's docstring.

# ---------------------------------------------------------------------------
# algo_v2_fx (FX cross-pairs bot: H1 order-block pullback entries only, no
# market entries, no ATR bridge -- one process loops over every symbol in
# FX_SYMBOLS each poll instead of one full bot per instrument. Reads the OB
# bridge already published per symbol by their MT5 OB-detection indicators.
# Own dedicated MT5 terminal connection -- the MetaTrader5-4 install these 9
# pairs actually run on, fully independent from algo_v2 (XAUUSD)'s terminal.
# Run with: python -m algo_v2_fx.main
# ---------------------------------------------------------------------------
FX_MT5_LOGIN=
FX_MT5_PASSWORD=
FX_MT5_SERVER=
FX_MT5_TERMINAL_PATH=C:\Program Files\MetaTrader5-4\terminal64.exe

FX_SYMBOLS=GBPJPY,EURAUD,AUDCHF,GBPAUD,AUDJPY,CHFJPY,CADCHF,AUDNZD,EURJPY
FX_LOTS=0.20
FX_MAGIC_NUMBER=26080601
FX_DEVIATION_POINTS=30
FX_POLL_SECONDS=1

# Must be explicitly "true" for any order to actually be sent. Left unset
# (default false), every decision is printed but nothing touches the account.
FX_ENABLE_TRADING=false

FX_STATE_FILE=fx_bot_state.json

# ---------------------------------------------------------------------------
# tv_bridge (receives TradingView webhook alerts) + tradingview_bot (reads
# them). Run the bridge with: python -m tv_bridge.receiver
# Run the bot with:           python -m tradingview_bot.main
# The bridge only binds locally -- reachable from TradingView through a
# tunnel (e.g. Cloudflare Tunnel) pointed at TV_WEBHOOK_HOST:TV_WEBHOOK_PORT.
# ---------------------------------------------------------------------------
# Required. Put the same value in the "secret" field of every TradingView
# alert message -- TradingView can't send custom headers, so this is how the
# bridge tells a real alert apart from a random request hitting the tunnel.
TV_WEBHOOK_SECRET=

TV_WEBHOOK_HOST=127.0.0.1
TV_WEBHOOK_PORT=8765

# Shared between the bridge (writer) and the bot (reader).
TV_SIGNAL_LOG_FILE=tv_bridge_signals.jsonl

TV_BOT_STATE_FILE=tradingview_bot_state.json
TV_ZONE_STATE_FILE=tradingview_bot_zones.json
TV_ATR_STATE_FILE=tradingview_bot_atr.json
TV_BOT_POLL_SECONDS=2

# ---------------------------------------------------------------------------
# tv_scraper -- pull alternative to tv_bridge/tradingview_bot above. Keeps a
# persistently logged-in TradingView chart open in an automated browser and
# polls its Data Window panel directly, instead of relying on alerts/webhooks.
# Writes its OWN state files (TV_SCRAPER_ZONE_STATE_FILE/_ATR_STATE_FILE
# below) -- deliberately NOT TV_ZONE_STATE_FILE/TV_ATR_STATE_FILE above, so
# running this alongside tv_bridge/tradingview_bot doesn't have the two
# processes clobber each other's zones (each store does a full unconditional
# overwrite on save). algo_v2_tv_xauusd's reader.py merges both sources at
# read time instead. Run with: python -m tv_scraper.scraper
# ---------------------------------------------------------------------------
TV_SCRAPER_CHART_URL=https://www.tradingview.com/chart/8MSjxMEZ/
TV_SCRAPER_SYMBOL=XAUUSD
TV_SCRAPER_TIMEFRAME=5
# Point this at your real browser profile (e.g. Brave's "User Data" folder)
# to reuse an already-logged-in session -- Google OAuth sign-in is blocked
# inside automated browsers, so a fresh empty profile can't complete login
# if your TradingView account uses "Sign in with Google". Only one process
# can hold a given profile at a time, so close that browser fully before
# starting the scraper.
TV_SCRAPER_PROFILE_DIR=tv_scraper_profile
TV_SCRAPER_POLL_SECONDS=5
# Optional -- point at an installed Chromium-based browser (e.g. Brave)
# instead of Playwright's bundled Chromium. Still uses a separate dedicated
# profile (TV_SCRAPER_PROFILE_DIR above), not your regular browser profile.
TV_SCRAPER_BROWSER_PATH=
# Pane grid on the chart layout at TV_SCRAPER_CHART_URL above -- e.g. 2x2
# for a 4-pane grid (one pane per timeframe: M1/M3/M5/M15, each already set
# up on TradingView with the OB detector, and M5 additionally with the ATR
# trail indicator). Each pane self-detects its own symbol/timeframe from
# its Data Window -- these two numbers just tell the scraper how many cells
# to click through and where their centers are. Defaults to 1x2 (the
# original hardcoded left/right split) so existing setups don't change
# behavior unless set explicitly.
TV_SCRAPER_GRID_ROWS=2
TV_SCRAPER_GRID_COLS=2

# Explicit window position/size for the automated browser, instead of
# forcing full-screen on every launch -- lets it sit in a fixed spot (e.g.
# half your monitor, alongside another app) without fighting your layout,
# and avoids a resize-mid-session race that can make panes briefly read
# each other's data (see tv_scraper/config.py's own comment). Defaults
# below are just an example (left half of a 3440x1440 monitor) -- set to
# match your own screen.
TV_SCRAPER_WINDOW_X=0
TV_SCRAPER_WINDOW_Y=0
TV_SCRAPER_WINDOW_WIDTH=1720
TV_SCRAPER_WINDOW_HEIGHT=1392

TV_SCRAPER_ZONE_STATE_FILE=tv_scraper_zones.json
TV_SCRAPER_ATR_STATE_FILE=tv_scraper_atr.json
# Persists each zone's stable "first observed" timestamp (see
# first_seen_store.py) so it survives a scraper restart.
TV_SCRAPER_FIRST_SEEN_FILE=tv_scraper_first_seen.json
# Persists trend/event_time (see atr_trend_tracker.py) -- trend is derived
# live from close vs trail_stop rather than needing a "Trend" plot on the
# chart at all (that plot broke the price scale's autoscale -- Pine v4 has
# no way to exclude a plot's VALUE from autoscale, only its visibility).
TV_SCRAPER_TREND_STATE_FILE=tv_scraper_trend.json
# Persists which zones have been RETESTED (price re-entering [btm, top]
# since formation) -- see retest_tracker.py. This is what "virgin" actually
# means (matches the MT5 indicator's own definition), NOT "not yet fully
# mitigated"/removed from the chart -- those are different, and a zone can
# be retested well before it's ever fully mitigated.
TV_SCRAPER_RETEST_FILE=tv_scraper_retest.json

# ---------------------------------------------------------------------------
# algo_v2_tv_xauusd (TVX) -- algo_v2's exact XAUUSD strategy (Order Block +
# ATR Trail zone rules: M1/M3/M5/M15 candidates, blocking, combined SL
# trailing), fed by tv_bridge/tradingview_bot's TradingView data instead of
# the MT5 OB/ATR-Trail indicator bridge. Runs alongside algo_v2 and the V1
# algo/ bot on the SAME terminal/account -- own magic number, state files,
# and "TVX" order-comment prefix so none of the three collide. Reuses the
# unprefixed MT5_LOGIN/PASSWORD/SERVER/TERMINAL_PATH above (same account).
# Run with: python -m algo_v2_tv_xauusd.main
# Requires tv_bridge.receiver + tradingview_bot.main both running, and live
# TradingView alerts on M1/M3/M5/M15 (OB detector) + M5 (ATR trail) pointed
# at your webhook URL -- read_zone/read_atr just return None for any
# timeframe with no data yet (fails closed, no entries).
# ---------------------------------------------------------------------------
TVX_SYMBOL=XAUUSD
TVX_LOTS=0.01
TVX_MAGIC_NUMBER=26081101
TVX_DEVIATION_POINTS=30
TVX_POLL_SECONDS=1
TVX_ATR_TIMEFRAME_MINUTES=5

TVX_ENABLE_TRADING=false

TVX_STATE_FILE=tvx_bot_state.json
TVX_BLOCKED_STATE_FILE=tvx_bot_blocks.json
TVX_SL_STATE_FILE=tvx_bot_sl_state.json
# Append-only history of every OB/ATR/bias event observed (formed,
# retested, mitigated, ATR flip, per-timeframe bias flip) -- see
# event_log.py/event_tracker.py. Purely observational for now, no effect
# on trading; this is what later execution logic will read.
TVX_EVENT_LOG_FILE=tvx_event_log.jsonl

# ---------------------------------------------------------------------------
# v3/signal_engine -- Signal Engine layer of V3 Sentinel (see
# project_v3_crypto_architecture memory note). Trend Manager is the first
# Manager built here; reads the same tv_scraper zone stores as Alert
# Manager, symbol-agnostic single instance for XAUUSD/BTCUSD/ETHUSD.
# Signal-only -- no MT5 order touched here at all, so no ENABLE_TRADING
# flag on this side (see v3/execution_bridge below for the one that
# matters). Decides bias, entry price/SL, and reads
# v3/execution_bridge's manual-cancel/close event file read-only.
# Run with: python -m v3.signal_engine.trend_manager
# ---------------------------------------------------------------------------
SIGNAL_ENGINE_POLL_SECONDS=5.0
TREND_MANAGER_MAGIC_NUMBER=26081701

# ---------------------------------------------------------------------------
# v3/execution_bridge -- Execution Bridge layer of V3 Sentinel. Reconciles
# real MT5 pending orders/positions against v3/signal_engine/trend_manager's
# own decisions (reads trend_manager_trade_state.json read-only). Reuses
# Trend Manager's own magic number -- every order this places IS a Trend
# Manager order, not a separately-identified one. Same
# MT5_LOGIN/PASSWORD/SERVER/TERMINAL_PATH as every other bot here.
#
# EXECUTION_BRIDGE_ENABLE_TRADING defaults false like every bot in this
# repo -- with it unset, every decision is printed ("WOULD place/cancel/
# close ...") but nothing ever touches the account. Flip it true only
# with the user's explicit go-ahead, and only after re-confirming each
# time (see this project's saved collaboration notes) -- never assume a
# prior approval carries forward.
# Run with: python -m v3.execution_bridge.execution_bridge
# ---------------------------------------------------------------------------
EXECUTION_BRIDGE_ENABLE_TRADING=false
EXECUTION_BRIDGE_DEVIATION_POINTS=30
EXECUTION_BRIDGE_POLL_SECONDS=2.0
EXECUTION_BRIDGE_XAUUSD_LOTS=0.04
EXECUTION_BRIDGE_BTCUSD_LOTS=0.05
EXECUTION_BRIDGE_ETHUSD_LOTS=1.0
EXECUTION_BRIDGE_ORDER_STATE_FILE=execution_bridge_orders.json
EXECUTION_BRIDGE_MANUAL_EVENTS_FILE=execution_bridge_manual_events.json

# Stoploss Manager's point-based trailing (see stoploss_manager.py) --
# breakeven once favor >= BREAKEVEN_POINTS, trailing starts at
# TRAIL_START_POINTS, moving in TRAIL_STEP_POINTS increments from there.
# These default the same for all three symbols (7/10/2) but that's an
# XAUUSD-scaled number carried over, not confirmed correct for
# BTCUSD/ETHUSD's own price scale -- see config.py's own comment.
EXECUTION_BRIDGE_XAUUSD_BREAKEVEN_POINTS=7
EXECUTION_BRIDGE_XAUUSD_TRAIL_START_POINTS=10
EXECUTION_BRIDGE_XAUUSD_TRAIL_STEP_POINTS=2
EXECUTION_BRIDGE_BTCUSD_BREAKEVEN_POINTS=7
EXECUTION_BRIDGE_BTCUSD_TRAIL_START_POINTS=10
EXECUTION_BRIDGE_BTCUSD_TRAIL_STEP_POINTS=2
EXECUTION_BRIDGE_ETHUSD_BREAKEVEN_POINTS=7
EXECUTION_BRIDGE_ETHUSD_TRAIL_START_POINTS=10
EXECUTION_BRIDGE_ETHUSD_TRAIL_STEP_POINTS=2
EXECUTION_BRIDGE_SL_STATE_FILE=execution_bridge_sl_state.json

# ---------------------------------------------------------------------------
# v3/signal_engine -- Reversal Manager. Separate component from Trend
# Manager, own magic number (can hold a same- or opposite-direction
# position simultaneously with Trend Manager's own trade). M5's own
# retest fires immediately; H4/H2/H1/M30/M15 retests wait for LTF
# (M1/M3/M5) confirmation. Signal-only -- not yet wired to Execution
# Bridge, so building/running this does not place real orders.
# Run with: python -m v3.signal_engine.reversal_manager
# ---------------------------------------------------------------------------
REVERSAL_MANAGER_POLL_SECONDS=5.0
REVERSAL_MANAGER_MAGIC_NUMBER=26081801
REVERSAL_MANAGER_STATE_FILE=reversal_manager_state.json
