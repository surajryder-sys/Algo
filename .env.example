# Copy this file to .env and fill in your own values. Never commit .env.

# MT5 terminal login credentials - only fill these in if you want the bot to
# actively log in itself. Leaving them blank (recommended) makes it attach to
# whatever account is already logged into the terminal at MT5_TERMINAL_PATH
# instead - safer, since filling these in with placeholder/wrong values will
# make it attempt a real login and disconnect whatever's already open.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Path to terminal64.exe (optional — omit to attach to an already-running terminal)
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Trading parameters
SYMBOL=EURUSD
TIMEFRAME=M15
FAST_MA_PERIOD=10
SLOW_MA_PERIOD=50
MA_METHOD=EMA

# Risk management
RISK_PERCENT=1.0
STOP_LOSS_PIPS=30
TAKE_PROFIT_PIPS=60
MAGIC_NUMBER=990011
DEVIATION_POINTS=20

# Loop
POLL_SECONDS=15

# Shared Telegram bot/chat for the virgin-zone entry alerts sent by algo/,
# eth_smc/, and btc_smc/ (see their alerts.py) -- purely informational,
# never places or touches an order. TELEGRAM_CHAT_ID: message the bot once,
# then open https://api.telegram.org/bot<token>/getUpdates to find your
# chat_id. Leave both blank to disable alerts entirely.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# ob_mtf_bot (zone-reaction reversal bot, OB+FVG bridge-driven) — shares
# MT5_LOGIN/PASSWORD/SERVER/TERMINAL_PATH above.
# Run with: python -m ob_mtf_bot.reversal_trader
# ---------------------------------------------------------------------------
OB_SYMBOL=XAUUSD

OB_LOTS=0.01
OB_SL_BUFFER=0.50
OB_MIN_SL_DISTANCE=7.00

OB_MAGIC_NUMBER=26071502
OB_DEVIATION_POINTS=30

OB_ENABLE_TRADING=true
OB_ENABLE_TRAILING=true

OB_POLL_SECONDS=5

# ---------------------------------------------------------------------------
# algo (SMC XAUUSD bot, reads the OB bridge published by
# mql5/OB_StatePublisher_Indicator_v2.00.mq5) — shares MT5_LOGIN/PASSWORD/
# SERVER/TERMINAL_PATH above.
# Run with: python -m algo.main
# ---------------------------------------------------------------------------
SMC_SYMBOL=XAUUSD
SMC_LOTS=0.01
SMC_MAGIC_NUMBER=26072501
SMC_DEVIATION_POINTS=30
SMC_POLL_SECONDS=1

# Must be explicitly "true" for any order to actually be sent/modified/
# cancelled. Left unset (default false), every decision is printed but
# nothing touches the account.
SMC_ENABLE_TRADING=false

SMC_STATE_FILE=smc_bot_state.json
SMC_BLOCKED_STATE_FILE=smc_bot_blocks.json

# ---------------------------------------------------------------------------
# eth_smc (SMC ETHUSD bot, reads the OB bridge published by
# mql5/OB_StatePublisher_Indicator_ETHUSD.mq5) -- fully independent from the
# XAUUSD bot above: its own MT5 terminal connection (a second terminal
# install, so it never touches the XAUUSD terminal that's already running),
# own login/credentials, own state/block files.
# Run with: python -m eth_smc.main
# ---------------------------------------------------------------------------
ETH_SMC_MT5_LOGIN=
ETH_SMC_MT5_PASSWORD=
ETH_SMC_MT5_SERVER=
ETH_SMC_MT5_TERMINAL_PATH=C:\Program Files\MetaTrader5-2\terminal64.exe

ETH_SMC_SYMBOL=ETHUSD
ETH_SMC_LOTS=1.0
ETH_SMC_MAGIC_NUMBER=26072701
ETH_SMC_DEVIATION_POINTS=30
ETH_SMC_POLL_SECONDS=1

# Must be explicitly "true" for any order to actually be sent/modified/
# cancelled. Left unset (default false), every decision is printed but
# nothing touches the account.
ETH_SMC_ENABLE_TRADING=false

ETH_SMC_STATE_FILE=eth_smc_bot_state.json
ETH_SMC_BLOCKED_STATE_FILE=eth_smc_bot_blocks.json
ETH_SMC_ALERT_STATE_FILE=eth_smc_bot_alerts.json

# ---------------------------------------------------------------------------
# btc_smc (SMC BTCUSD bot, reads the OB bridge published by
# mql5/OB_StatePublisher_Indicator_BTCUSD.mq5) -- fully independent from the
# XAUUSD and ETHUSD bots above: its own MT5 terminal connection (a third
# terminal install), own login/credentials, own state/block files.
# Run with: python -m btc_smc.main
# ---------------------------------------------------------------------------
BTC_SMC_MT5_LOGIN=
BTC_SMC_MT5_PASSWORD=
BTC_SMC_MT5_SERVER=
BTC_SMC_MT5_TERMINAL_PATH=C:\Program Files\MetaTrader5-4\terminal64.exe

BTC_SMC_SYMBOL=BTCUSD
BTC_SMC_LOTS=0.05
BTC_SMC_MAGIC_NUMBER=26072801
BTC_SMC_DEVIATION_POINTS=30
BTC_SMC_POLL_SECONDS=1

# Must be explicitly "true" for any order to actually be sent/modified/
# cancelled. Left unset (default false), every decision is printed but
# nothing touches the account.
BTC_SMC_ENABLE_TRADING=false

BTC_SMC_STATE_FILE=btc_smc_bot_state.json
BTC_SMC_BLOCKED_STATE_FILE=btc_smc_bot_blocks.json
BTC_SMC_ALERT_STATE_FILE=btc_smc_bot_alerts.json

# ---------------------------------------------------------------------------
# algo_v2_usoil (SMC USOIL bot, Order Block + ATR Trail zone rules, M5-only
# execution tier for now -- M15/M30 to follow), reads the OB bridge
# published by mql5/OB_State_USOIL_2.0.mq5 -- fully independent from
# algo_v2 (XAUUSD): its own MT5 terminal connection (a separate terminal
# install, so it never touches the XAUUSD terminal that's already running),
# own login/credentials, own magic number/state/block files.
# Run with: python -m algo_v2_usoil.main
# ---------------------------------------------------------------------------
SMC_V2_USOIL_MT5_LOGIN=
SMC_V2_USOIL_MT5_PASSWORD=
SMC_V2_USOIL_MT5_SERVER=
SMC_V2_USOIL_MT5_TERMINAL_PATH=C:\Program Files\MetaTrader5-3\terminal64.exe

SMC_V2_USOIL_SYMBOL=USOIL
SMC_V2_USOIL_LOTS=0.01
SMC_V2_USOIL_MAGIC_NUMBER=26080501
SMC_V2_USOIL_DEVIATION_POINTS=30
SMC_V2_USOIL_POLL_SECONDS=1
SMC_V2_USOIL_ATR_TIMEFRAME_MINUTES=15

# Must be explicitly "true" for any order to actually be sent/modified/
# cancelled. Left unset (default false), every decision is printed but
# nothing touches the account.
SMC_V2_USOIL_ENABLE_TRADING=false

SMC_V2_USOIL_STATE_FILE=smc_v2_usoil_bot_state.json
SMC_V2_USOIL_BLOCKED_STATE_FILE=smc_v2_usoil_bot_blocks.json

# ---------------------------------------------------------------------------
# algo_v2_fx (FX cross-pairs bot: H1 order-block pullback entries only, no
# market entries, no ATR bridge -- one process loops over every symbol in
# FX_SYMBOLS each poll instead of one full bot per instrument. Reads the OB
# bridge already published per symbol by their MT5 OB-detection indicators.
# Own dedicated MT5 terminal connection -- the MetaTrader5-4 install these 9
# pairs actually run on, fully independent from algo_v2 (XAUUSD)'s terminal.
# Run with: python -m algo_v2_fx.main
# ---------------------------------------------------------------------------
FX_MT5_LOGIN=
FX_MT5_PASSWORD=
FX_MT5_SERVER=
FX_MT5_TERMINAL_PATH=C:\Program Files\MetaTrader5-4\terminal64.exe

FX_SYMBOLS=GBPJPY,EURAUD,AUDCHF,GBPAUD,AUDJPY,CHFJPY,CADCHF,AUDNZD,EURJPY
FX_LOTS=0.20
FX_MAGIC_NUMBER=26080601
FX_DEVIATION_POINTS=30
FX_POLL_SECONDS=1

# Must be explicitly "true" for any order to actually be sent. Left unset
# (default false), every decision is printed but nothing touches the account.
FX_ENABLE_TRADING=false

FX_STATE_FILE=fx_bot_state.json
